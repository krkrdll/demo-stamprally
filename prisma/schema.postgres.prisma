generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Checkpoint {
  id             String   @id
  type           String
  order          Int      @default(0)
  lat            Float?
  lng            Float?
  markerImageUrl String?
  passcode       String?
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
