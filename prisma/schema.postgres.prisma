generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Checkpoint {
  id          String                @id
  order       Int                   @default(0)
  title       String
  description String?
  imageUrl    String?
  conditions  CheckpointCondition[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CheckpointCondition {
  id             String     @id
  checkpointId   String
  checkpoint     Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  type           String
  lat            Float?
  lng            Float?
  radiusMeters   Float?     @default(20)
  markerImageUrl String?
  passcode       String?
  sortOrder      Int        @default(0)
}

model SiteSettings {
  id        String   @id @default("default")
  siteTitle String   @default("スタンプラリー")
  theme     String   @default("amber")
  updatedAt DateTime @updatedAt
}

model UserSession {
  id        String      @id
  stamps    UserStamp[]
  createdAt DateTime    @default(now())
}

model UserStamp {
  id           String      @id
  sessionId    String
  session      UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkpointId String
  title        String
  collectedAt  DateTime    @default(now())

  @@unique([sessionId, checkpointId])
}
